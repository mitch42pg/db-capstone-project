import mysql.connector

# Connect to MySQL
conn = mysql.connector.connect(
    host="localhost",
    user="your_username",
    password="your_password",
    database="LittleLemonDB"
)
cursor = conn.cursor()

# AddBooking Procedure
def add_booking(customer_id, table_id, booking_date):
    query = "INSERT INTO Bookings (CustomerID, TableID, BookingDate) VALUES (%s, %s, %s)"
    cursor.execute(query, (customer_id, table_id, booking_date))
    conn.commit()

# UpdateBooking Procedure
def update_booking(booking_id, new_date):
    query = "UPDATE Bookings SET BookingDate = %s WHERE BookingID = %s"
    cursor.execute(query, (new_date, booking_id))
    conn.commit()

# CancelBooking Procedure
def cancel_booking(booking_id):
    query = "DELETE FROM Bookings WHERE BookingID = %s"
    cursor.execute(query, (booking_id,))
    conn.commit()

# GetMaxQuantity Procedure
def get_max_quantity():
    cursor.execute("SELECT MAX(Quantity) FROM OrderDetails")
    result = cursor.fetchone()
    print(f"Max Quantity Ordered: {result[0]}")

# ManageBooking Procedure
def manage_booking(action, **kwargs):
    if action == "add":
        add_booking(kwargs['customer_id'], kwargs['table_id'], kwargs['booking_date'])
    elif action == "update":
        update_booking(kwargs['booking_id'], kwargs['new_date'])
    elif action == "cancel":
        cancel_booking(kwargs['booking_id'])
    else:
        print("Invalid Action")

# Example
manage_booking(action="add", customer_id=1, table_id=2, booking_date="2025-06-20")
get_max_quantity()

cursor.close()
conn.close()
